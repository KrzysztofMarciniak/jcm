; Read a number and print whether it is even.
;
; Input is read from stdin, not from a command-line argument:
;   printf '99\n' | ./jcm --eval examples/input-check.jcm
;
; The result is printed as a numeric boolean:
;   even? 0
;
; Note: ↓ writes one character (a byte), so it is not a decimal-number
; printer. For example, (↓ 99) writes the character 'c'.

(n : (↑))

; Print "even? " followed by 1 for even or 0 for odd.
(↓ 101) ; 'e'
(↓ 118) ; 'v'
(↓ 101) ; 'e'
(↓ 110) ; 'n'
(↓ 63)  ; '?'
(↓ 32)  ; ' '
(↓ (+ 48 (if (= (% n 2) 0) 1 0)))
(↓ 10)
